{
  "name": "agente-promo-ml",
  "version": "1.0.0",
  "description": "Agente que busca promoções no Mercado Livre e posta em um grupo do WhatsApp com seu link de afiliado",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "dry-run": "node src/index.js --once --dry-run",
    "ml-login": "node src/ml-login.js",
    "ml-entrar": "node src/ml-entrar.js",
    "list-groups": "node src/index.js --list-groups",
    "setup-group": "node src/index.js --setup-group",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^16.4.5",
    "playwright-core": "^1.64.1",
    "pino": "^10.4.0"
  }
}

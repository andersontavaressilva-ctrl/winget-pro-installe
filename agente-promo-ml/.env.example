# ===================== MERCADO LIVRE (API oficial) =====================
# Crie um app em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Redirect URI cadastrado no app do Mercado Livre (tem que ser igual)
ML_REDIRECT_URI=https://www.google.com/
# Preenchido automaticamente pelo comando "npm run ml-login"
ML_REFRESH_TOKEN=

# Site do Mercado Livre (MLB = Brasil)
ML_SITE=MLB

# Termos de busca separados por ";" (cada um vira uma busca)
SEARCH_TERMS=fone bluetooth;smartwatch;air fryer;kit ferramentas;tenis masculino;perfume importado
# Categorias (IDs) para buscar os MAIS VENDIDOS (top 20 de cada), separadas por ";"
# Celulares; Informática; Eletrônicos; Eletrodomésticos; Casa; Beleza; Esportes;
# Roupas/Calçados; Brinquedos; Ferramentas; Games
SEARCH_CATEGORIES=MLB1051;MLB1648;MLB1000;MLB5726;MLB1574;MLB1246;MLB1276;MLB1430;MLB1132;MLB263532;MLB1144
# Resultados por busca (máx. 50)
RESULTS_PER_SEARCH=50

# ===================== FILTROS / PONTUAÇÃO =====================
MIN_DISCOUNT_PERCENT=20
MIN_PRICE=20
MAX_PRICE=1500
# Exigir frete grátis? (true/false)
REQUIRE_FREE_SHIPPING=false
# Nota mínima (0-100) para o produto ser postado
MIN_SCORE=55

# ===================== LINK DE AFILIADO =====================
# Modelo do link. Variáveis: {url} (link do produto), {url_encoded}, {id}
# Abra um link seu gerado no painel de afiliados, veja os parâmetros que
# aparecem no final da URL expandida e coloque aqui. Exemplo:
AFFILIATE_LINK_TEMPLATE={url}?matt_tool=SEU_MATT_TOOL&matt_word=SEU_MATT_WORD
# Opcional: arquivo JSON com links curtos gerados manualmente no painel
# ({ "MLB123456": "https://mercadolivre.com/sec/abc123" }). Tem prioridade.
AFFILIATE_LINKS_FILE=./data/links-afiliado.json

# ===================== WHATSAPP =====================
# Seu número com DDI e DDD (ex.: 5511999998888). Se preenchido, a conexão
# usa código de pareamento em vez de QR Code (ideal quando você só tem o celular).
WHATSAPP_PHONE_NUMBER=
# Nome exato do grupo (use "npm run list-groups" para ver os nomes/IDs)
WHATSAPP_GROUP_NAME=Promoções do Anderson
# Ou o ID do grupo (tem prioridade), ex.: 1203630xxxxxxxx@g.us
WHATSAPP_GROUP_ID=

# ===================== AGENDAMENTO =====================
# Intervalo entre ciclos de busca (minutos)
INTERVAL_MINUTES=60
# Quantos produtos postar por ciclo
POSTS_PER_CYCLE=3
# Espera entre uma mensagem e outra (segundos) — evite valores baixos
DELAY_BETWEEN_POSTS_SECONDS=90
# Horário permitido para postar (24h)
POST_START_HOUR=8
POST_END_HOUR=22
# Não repetir o mesmo produto antes de X dias
REPOST_AFTER_DAYS=7
